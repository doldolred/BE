# 운영 서버용 — 서버에서: cp .env.prod.example .env && vi .env   (.env 는 git 에 올라가지 않는다)

# ── 주소 ──────────────────────────────────────────────
# 대표 주소 (인증서 · 결제 후 돌아올 주소 · CORS 가 모두 이 값)
DOMAIN=www.doldol.co.kr
# 대표 주소로 넘길 다른 이름 (공백으로 여러 개). 둘 다 DNS A 레코드가 서버 고정 IP 를 가리켜야 한다
DOMAIN_ALIASES=doldol.co.kr
# 인증서 만료 알림 받을 메일
LETSENCRYPT_EMAIL=

# ── 이미지 (CI 가 GHCR 에 올린 것) ───────────────────
BACKEND_IMAGE=ghcr.io/doldolred/be:latest
FRONTEND_IMAGE=ghcr.io/doldolred/fe:latest

# ── DB ────────────────────────────────────────────────
DB_NAME=doldol
DB_USERNAME=doldol
# 긴 무작위 값: openssl rand -base64 24
DB_PASSWORD=

# ── 인증 ──────────────────────────────────────────────
# 32자 이상 무작위: openssl rand -base64 48
JWT_SECRET=

# ── 결제 (나이스페이 START) ───────────────────────────
PAYMENT_PROVIDER=nicepay
PAYMENT_PENDING_TIMEOUT=PT30M
# 운영 키로 바꿀 때 API 주소도 함께: https://api.nicepay.co.kr
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
NICEPAY_API_URL=https://sandbox-api.nicepay.co.kr
# 포트원은 나중(정산 때 나이스페이먼츠로 갈아탈 때)
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# ── DB 백업 ──────────────────────────────────────────
# 매일 이 시각(한국 시간)에 ./backups 에 덤프, KEEP_DAYS 일 지난 건 지운다
BACKUP_AT_KST_HOUR=4
BACKUP_KEEP_DAYS=14
# 서버가 통째로 망가져도 남도록 Lightsail 버킷에도 올리려면 (버킷 → 액세스 키 만들기)
# 예: s3://doldol-backup/db
BACKUP_S3_URI=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=ap-northeast-2
