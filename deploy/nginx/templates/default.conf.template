# 운영 입구(edge). ${DOMAIN} · ${DOMAIN_ALIASES} 는 컨테이너가 뜰 때 .env 값으로 채워진다.
# 인증서: /etc/letsencrypt/live/${DOMAIN}/ (init-letsencrypt.sh 로 첫 발급, certbot 컨테이너가 갱신)

# 로그인 · 회원가입 무차별 대입 막기 — IP 당 초당 5회
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;
limit_req_status 429;

upstream doldol_backend {
    server backend:8080;
    keepalive 16;
}

upstream doldol_frontend {
    server frontend:80;
}

# ── http: 인증서 발급 확인용 경로만 남기고 전부 https 로 ──
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} ${DOMAIN_ALIASES};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# ── https: 다른 이름(예: doldol.co.kr)은 대표 주소(www)로 ──
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_ALIASES};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 301 https://${DOMAIN}$request_uri;
}

# ── https: 본 사이트 ──
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HTTPS 가 문제없이 도는 걸 확인한 뒤 켠다 (켜면 브라우저가 1년간 http 로 오지 않는다)
    # add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    client_max_body_size 10m;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;

    location /api/auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://doldol_backend;
    }

    # 나이스페이 결제 결과(form POST) · 포트원 웹훅도 여기로 들어온다
    location /api/ {
        proxy_pass http://doldol_backend;
    }

    # /actuator 등 나머지 백엔드 경로는 밖으로 열지 않는다 — 화면은 전부 frontend
    location / {
        proxy_pass http://doldol_frontend;
    }
}
