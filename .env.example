# cp .env.example .env 후 값 변경 (.env 는 git에 올리지 않음)
DB_NAME=doldol
DB_USERNAME=doldol
# 로컬 bootRun 기본값과 같음. 운영 서버에서는 반드시 변경
DB_PASSWORD=doldol
DB_PORT=5432

SPRING_PROFILES_ACTIVE=prod
# 32바이트 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# 도메인 확정 후 https://도메인 으로 변경
CORS_ALLOWED_ORIGINS=http://localhost

WEB_PORT=80

# ── 결제 ─────────────────────────────────────────
# nicepay: 나이스페이 START 직접 연동(지금) / portone: 포트원 경유(정산 때 나이스페이먼츠로 갈아탈 때)
# BE 와 FE 가 같은 값을 써야 한다 (FE 는 빌드할 때 들어감)
PAYMENT_PROVIDER=nicepay
# 결제 후 돌아갈 FE 주소. 같은 도메인이면 비워 둔다
FRONTEND_URL=
# 결제 안 한 주문 자동 취소까지 (ISO-8601, PT30M = 30분)
PAYMENT_PENDING_TIMEOUT=PT30M
# 자동 취소 대상을 확인하는 주기
PAYMENT_EXPIRE_CHECK_INTERVAL=PT1M

# 나이스페이 START — 가맹점관리자 TEST 상점에서 발급. client-id 는 공개돼도 되는 값, secret-key 는 비밀
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
# 운영: https://api.nicepay.co.kr
NICEPAY_API_URL=https://sandbox-api.nicepay.co.kr

# 포트원 V2 — 콘솔 > 결제연동. store-id · channel-key 는 공개 값, api-secret · webhook-secret 은 비밀
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
