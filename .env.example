# cp .env.example .env 후 값 변경 (.env 는 git에 올리지 않음)
DB_NAME=doldol
DB_USERNAME=doldol
# 로컬 bootRun 기본값과 같음. 운영 서버에서는 반드시 변경
DB_PASSWORD=doldol
DB_PORT=5432

SPRING_PROFILES_ACTIVE=prod
# 32바이트 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# 도메인 확정 후 https://도메인 으로 변경
CORS_ALLOWED_ORIGINS=http://localhost

WEB_PORT=80
